# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/artisan_marketplace
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=artisan_marketplace

# Auth0
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your_client_id
AUTH0_CLIENT_SECRET=your_client_secret
AUTH0_AUDIENCE=https://artisan-marketplace.api

# Gemini AI (catalog, translation, pricing, story engine, image enhancement)
GEMINI_API_KEY=your_gemini_api_key

# ElevenLabs Voice AI (voice cloning, TTS, Dubbing — Awaaz Milan)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Shilpika Visual AI pipeline tuning (PRD v4 §11)
IMAGE_QUALITY_THRESHOLD=0.35
IMAGE_FIDELITY_TOLERANCE=0.12

# Solana provenance minting (optional / Web3 bonus track)
SOLANA_RPC_URL=
SOLANA_WALLET_PRIVATE_KEY=

# Google Cloud
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json
STORAGE_BUCKET=artisan-marketplace-media

# Market Data (Tiger Data)
MARKET_DATA_PROVIDER=mock
MARKET_DATA_PROVIDER_URL=https://api.tigerdata.example.com
MARKET_DATA_PROVIDER_API_KEY=your_tigerdata_key

# App Config
NODE_ENV=development
PORT=3000
JWT_SECRET=your_jwt_secret_for_local_dev
API_VERSION=v1

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Brevo (Sendinblue) — transactional email for signup/login OTP verification
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=questcivic@gmail.com
BREVO_SENDER_NAME=Shilpika
